{
  "name": "vibecards",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--import=./instrument.server.mjs vite dev --port 3000",
    "build": "vite build",
    "clean": "bunx rimraf .output .vite .turbo node_modules coverage playwright .tanstack src/routeTree.gen.ts",
    "start": "vite preview --port 3000",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "lefthook install",
    "load-env": "dotenv -e .env.local --",
    "auth:generate": "bun run load-env -- bunx @better-auth/cli generate --output src/database/auth-schema.ts --config src/lib/auth.ts",
    "db:pull": "bun run load-env -- drizzle-kit pull",
    "db:push": "bun run load-env -- drizzle-kit push",
    "db:generate": "bun run load-env -- drizzle-kit generate",
    "db:view": "bun run load-env -- drizzle-kit studio"
  },
  "engines": {
    "bun": ">=24.14"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@logtape/logtape": "^2.0.7",
    "@logtape/sentry": "^2.0.7",
    "@sentry/tanstackstart-react": "^10.52.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/ai": "^0.15.0",
    "@tanstack/ai-gemini": "^0.10.1",
    "@tanstack/react-form": "^1.29.3",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/router-plugin": "^1.167.35",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260429-beta",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typewriter-effect": "^2.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form-devtools": "^0.2.24",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.5.14",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
